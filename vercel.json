{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "brain-gym": {
      "root": ".",
      "framework": "express",
      "buildCommand": "npm install"
    },
    "cursor-relax": {
      "root": "games/cursor-relax",
      "framework": "vite"
    },
    "golden-arrow": {
      "root": "games/golden-arrow",
      "framework": "vite"
    },
    "kaleidoscope": {
      "root": "games/kaleidoscope",
      "framework": "vite"
    },
    "math-challenge": {
      "root": "games/math-challenge",
      "framework": "vite"
    },
    "memory-game": {
      "root": "games/memory-game",
      "framework": "vite"
    },
    "neon-rod-racer": {
      "root": "games/neon-rod-racer",
      "framework": "vite"
    },
    "puzzle-progression": {
      "root": "games/puzzle-progression",
      "framework": "vite"
    },
    "zen-rake": {
      "root": "games/zen-rake",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "brain-gym"
      }
    }
  ]
}
